          "type": "number"
        },
        "successes": {
          "title": "Successes",
          "type": "integer"
        },
        "trials": {
          "title": "Trials",
          "type": "integer"
        }
      },
      "required": [
        "successes",
        "trials",
        "level",
        "estimand",
        "estimate",
        "interval"
      ],
      "title": "Rate",
      "type": "object"
    },
