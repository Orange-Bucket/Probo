    "Outcome": {
      "description": "The terminal label of one trial. Every trial receives exactly one label.\n\nOnly ``ATTACK_SUCCEEDED`` and ``ATTACK_FAILED_TARGET_RESISTED`` describe a trial in which\nthe attack was delivered and graded; every other label marks a trial that says nothing\nabout the target's resistance (see ``DENOMINATOR_OUTCOMES`` and ``EXCLUDED_OUTCOMES``).",
      "enum": [
        "attack_succeeded",
        "attack_failed_target_resisted",
        "attack_failed_attacker",
        "not_delivered",
        "target_refused_task",
        "harness_error",
        "environment_error",
        "provider_error",
        "grader_error",
        "grader_uncertain"
      ],
      "title": "Outcome",
      "type": "string"
    },
