    "Proportion": {
      "additionalProperties": false,
      "description": "A binomial proportion x / n with its two-sided Wilson interval at ``level``.\n\nStores only ``successes``, ``trials`` and ``level``; ``estimate`` and ``interval`` are\ncomputed from them and included in dumps. Loading accepts those derived keys only when\nthey agree with the recomputed values (see ``FrozenModel``).",
      "properties": {
        "estimate": {
          "description": "Point estimate x / n, computed from the counts.",
          "readOnly": true,
          "title": "Estimate",
          "type": "number"
        },
        "interval": {
          "$ref": "#/$defs/Interval",
          "description": "``wilson_interval(successes, trials, level)``, computed from the stored fields.",
          "readOnly": true
        },
        "level": {
          "title": "Level",
          "type": "number"
        },
        "successes": {
          "title": "Successes",
          "type": "integer"
        },
