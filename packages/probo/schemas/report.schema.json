        "estimate",
        "interval"
      ],
      "title": "Proportion",
      "type": "object"
    },
    "Rate": {
      "additionalProperties": false,
      "description": "An attack success rate: a binomial proportion labelled with what it estimates.\n\nStores ``successes``, ``trials``, ``level`` and ``estimand``; ``estimate = successes /\ntrials`` and ``interval = wilson_interval(successes, trials, level)`` are computed and\nincluded in dumps. Loading accepts those derived keys only when they agree with the\nrecomputed values (see ``FrozenModel``).",
      "properties": {
        "estimand": {
          "$ref": "#/$defs/Estimand"
        },
        "estimate": {
          "description": "Point estimate x / n, computed from the counts.",
          "readOnly": true,
          "title": "Estimate",
          "type": "number"
        },
        "interval": {
